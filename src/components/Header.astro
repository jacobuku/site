---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="site-title" href="/">{SITE_TITLE}</a>
		<div class="links">
			<HeaderLink href="/essays/">长文</HeaderLink>
			<HeaderLink href="/notes/">想法</HeaderLink>
			<HeaderLink href="/about/">关于</HeaderLink>
		</div>
	</nav>
</header>

<style>
	/* 横向留白和宽度由 global.css 的 header 规则统一管，这里只管内部布局。 */
	nav {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		flex-wrap: wrap;
	}
	.site-title {
		color: var(--text);
		font-weight: 600;
		text-decoration: none;
	}
	.links {
		display: flex;
		gap: 1.25rem;
	}
</style>
