---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	essays: CollectionEntry<'essays'>[];
}

const { essays } = Astro.props;
---

<ul class="essay-list">
	{
		essays.map((essay) => (
			<li>
				<a href={`/essays/${essay.id}/`}>{essay.data.title}</a>
				<span class="meta">
					<FormattedDate date={essay.data.date} />
					{essay.data.draft && <span class="draft">草稿</span>}
				</span>
			</li>
		))
	}
</ul>

<style>
	.essay-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.essay-list li {
		margin-bottom: 1.4em;
	}
	.essay-list a {
		display: block;
		color: var(--text);
		text-decoration-color: var(--rule);
	}
	.essay-list a:hover {
		text-decoration-color: currentColor;
	}
	.meta {
		display: flex;
		align-items: baseline;
		gap: 0.6em;
	}
	.draft {
		color: var(--muted);
		font-size: 0.85em;
	}
</style>
