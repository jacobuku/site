---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';
import { SITE_LANG } from '../consts';
import Base from './Base.astro';

interface Props {
	essay: CollectionEntry<'essays'>;
}

const { essay } = Astro.props;
const { title, date, tags, lang, draft, description } = essay.data;

// lang: en 的文章页面把 <html lang> 改成 en，其余用站点默认语言。
const htmlLang = lang === 'en' ? 'en' : SITE_LANG;
const draftLabel = lang === 'en' ? 'Draft' : '草稿';
---

<Base title={title} description={description ?? title} lang={htmlLang}>
	<article>
		<header class="essay-header">
			<h1>{title}</h1>
			<p class="meta">
				<FormattedDate date={date} />
				{draft && <span class="draft">{draftLabel}</span>}
			</p>
			{tags.length > 0 && <TagList tags={tags} />}
		</header>
		<slot />
	</article>
</Base>

<style>
	.essay-header {
		margin-bottom: 2.5rem;
	}
	.meta {
		display: flex;
		align-items: baseline;
		gap: 0.6em;
		margin: 0 0 0.4em;
	}
	.draft {
		color: var(--muted);
		font-size: 0.85em;
	}
</style>
