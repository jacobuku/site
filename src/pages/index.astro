---
import EssayList from '../components/EssayList.astro';
import NoteItem from '../components/NoteItem.astro';
import Base from '../layouts/Base.astro';
import { getEssays, getNotes } from '../lib/collections';

const essays = (await getEssays()).slice(0, 3);
const notes = (await getNotes()).slice(0, 10);
---

<Base>
	<section>
		<h2 class="section-title">长文</h2>
		<EssayList essays={essays} />
		{essays.length > 0 && (
			<p class="more">
				<a href="/essays/">全部长文 →</a>
			</p>
		)}
	</section>

	<section class="notes">
		<h2 class="section-title">想法</h2>
		{notes.length === 0 && <p class="empty">还没有想法。</p>}
		{notes.map((note) => <NoteItem note={note} />)}
		{notes.length > 0 && (
			<p class="more">
				<a href="/notes/">全部想法 →</a>
			</p>
		)}
	</section>
</Base>

<style>
	.section-title {
		margin: 0 0 1.5rem;
		color: var(--muted);
		font-size: 0.85em;
		font-weight: 600;
		letter-spacing: 0.06em;
	}
	.notes {
		margin-top: 4rem;
	}
	.more {
		margin: 0;
		font-size: 0.9em;
	}
</style>
